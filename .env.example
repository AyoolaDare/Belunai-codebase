# Copy to .env.local for local development. Never commit real values.
# Values come from the managed environment configuration for each environment
# (local, staging, production are separate projects with separate credentials).

# Public: safe to ship to the browser. Added with BEL-0201 (Supabase environments).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: must never be prefixed NEXT_PUBLIC_ or imported by client code.
# SUPABASE_SECRET_KEY=

# Opt out of framework telemetry.
NEXT_TELEMETRY_DISABLED=1
